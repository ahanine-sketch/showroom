generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String              @id @default(uuid())
  fullName         String
  email            String?             @unique
  phone            String?
  passwordHash     String
  role             Role                @default(COMMERCIAL)
  showroomId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  avatarUrl        String?
  seniority        String?
  status           UserStatus          @default(ACTIVE)
  bonusHistory     BonusHistory[]
  clientReviews    ClientReview[]
  logs             DailyLog[]
  dailyScores      DailyScore[]
  formations       FormationProgress[]
  objectives       Objective[]
  evaluations      ProcessEvaluation[]
  salesMetrics     SalesMetric[]
  managedShowrooms Showroom[]          @relation("Manager")
  showroom         Showroom?           @relation(fields: [showroomId], references: [id])
}

model Showroom {
  id            String              @id @default(uuid())
  name          String
  location      String?
  city          String?
  managerId     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  clientReviews ClientReview[]
  logs          DailyLog[]
  objectives    Objective[]
  evaluations   ProcessEvaluation[]
  manager       User?               @relation("Manager", fields: [managerId], references: [id])
  users         User[]
}

model Objective {
  id             String          @id @default(uuid())
  userId         String?
  showroomId     String?
  month          Int
  year           Int
  dateStart      DateTime?
  dateEnd        DateTime?
  conservativeCA Float
  likelyCA       Float
  exceedCA       Float
  type           String          @default("GLOBAL")
  status         ObjectiveStatus @default(CONFIRMED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  showroom       Showroom?       @relation(fields: [showroomId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([userId, dateStart, dateEnd])
  @@index([showroomId, dateStart, dateEnd])
}

model SalesMetric {
  id             String   @id @default(uuid())
  userId         String?
  showroomId     String?
  date           DateTime @default(now())
  ca             Float    @default(0)
  savCount       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  avgBasket      Float    @default(0)
  devisCreated   Int      @default(0)
  devisLost      Int      @default(0)
  devisValidated Int      @default(0)
  devisOpened    Int      @default(0)
  user           User?    @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([showroomId, date])
}

model DailyScore {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime @default(now())
  totalScore    Float    @default(0)
  salesScore    Float    @default(0)
  behaviorScore Float    @default(0)
  details       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bonusScore    Float    @default(0)
  presenceScore Float    @default(0)
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model ScoringConfig {
  id         String   @id @default(uuid())
  metricName String   @unique
  weight     Float
  levels     Json
  updatedAt  DateTime @updatedAt
}

model ProcessEvaluation {
  id              String         @id @default(uuid())
  userId          String?
  showroomId      String?
  date            DateTime       @default(now())
  notes           String?
  createdAt       DateTime       @default(now())
  absencesCount   Int?
  complaintsCount Int?
  minusAvis       Int?
  plusAvis        Int?
  retardsCount    Int?
  ticketsCount    Int?
  type            EvaluationType
  warningLevel    Int?
  showroom        Showroom?      @relation(fields: [showroomId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([showroomId, date])
}

model DailyLog {
  id         String    @id @default(uuid())
  userId     String?
  showroomId String?
  date       DateTime  @default(now())
  activity   String
  status     String
  notes      String?
  showroom   Showroom? @relation(fields: [showroomId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([showroomId, date])
}

model FormationProgress {
  id         String   @id @default(uuid())
  userId     String
  resourceId String
  progress   Int
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model GlobalSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model BonusHistory {
  id          String    @id @default(uuid())
  userId      String
  amount      Float
  description String
  date        DateTime  @default(now())
  month       Int
  year        Int
  dateStart   DateTime?
  dateEnd     DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, dateStart, dateEnd])
}

model MonthlySnapshot {
  id                  String   @id @default(uuid())
  userId              String?
  showroomId          String?
  month               Int
  year                Int
  type                String   // "COMMERCIAL" | "SHOWROOM"
  
  // Sales Metrics
  totalCA             Float    @default(0)
  totalDevisCreated   Int      @default(0)
  totalDevisValidated Int      @default(0)
  totalDevisLost      Int      @default(0)
  totalDevisOpened    Int      @default(0)
  avgBasket           Float    @default(0)
  
  // Scores
  salesScore          Float    @default(0)
  behaviorScore       Float    @default(0)
  presenceScore       Float    @default(0)
  bonusScore          Float    @default(0)
  globalScore         Float    @default(0)
  
  // Objectifs
  conservativeCA      Float    @default(0)
  likelyCA            Float    @default(0)
  exceedCA            Float    @default(0)
  caAchievedPercent   Float    @default(0)
  
  // Behavior Summary
  avisPositifs        Int      @default(0)
  avisNegatifs        Int      @default(0)
  savTickets          Int      @default(0)
  savPlaintes         Int      @default(0)
  processWarnings     Int      @default(0)
  
  // Presence
  absences            Int      @default(0)
  retards             Int      @default(0)
  
  // Bonus
  totalBonus          Float    @default(0)
  
  // Metadata
  frozenAt            DateTime @default(now())
  data                Json?    // Optional field for extra blob data

  @@unique([userId, month, year])
  @@unique([showroomId, month, year])
}

model ClientReview {
  id         String    @id @default(uuid())
  userId     String?
  showroomId String?
  name       String
  rating     Int
  comment    String?
  date       DateTime  @default(now())
  createdAt  DateTime  @default(now())
  showroom   Showroom? @relation(fields: [showroomId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])
}

enum Role {
  OWNER
  ADMIN
  COMMERCIAL
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ObjectiveStatus {
  DRAFT
  CONFIRMED
}

enum EvaluationType {
  AVIS
  SAV
  PROCESS
  PRESENCE
  DAILY_NOTE
  SHOWROOM
}

